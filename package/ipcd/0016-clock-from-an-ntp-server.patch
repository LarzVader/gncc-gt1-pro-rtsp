+
+static uint32_t be32(const uint8_t *p)
+{
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+           ((uint32_t)p[2] << 8) | (uint32_t)p[3];
+}
+
+/* An NTP timestamp in seconds since 1970. It wraps in 2036. */
+static double ntp_time(const uint8_t *p)
+{
+    uint32_t secs = be32(p);
+    double t = (double)secs - 2208988800.0;
+    if (!(secs & 0x80000000u)) t += 4294967296.0;
+    return t + (double)be32(p + 4) / 4294967296.0;
+}
+
+/* Asks the server once. server is a name or an address, optionally with
+ * :port. Returns 0 and how far our clock is behind. */
+static int ntp_query(char *server, double *offset)
+{
+    const char *port = "123";
+    char *colon = strchr(server, ':');
+    if (colon) {
+        *colon = 0;
+        port = colon + 1;
+    }
+    struct addrinfo hints, *ai = NULL;
+    memset(&hints, 0, sizeof(hints));
+    hints.ai_family = AF_INET;
+    hints.ai_socktype = SOCK_DGRAM;
+    if (getaddrinfo(server, port, &hints, &ai) != 0) return -1;
+
+    /* Connected: The kernel only hands us what comes from the server. */
+    int s = socket(ai->ai_family, ai->ai_socktype, 0);
+    if (s < 0 || connect(s, ai->ai_addr, ai->ai_addrlen) != 0) {
+        if (s >= 0) close(s);
+        freeaddrinfo(ai);
+        return -1;
+    }
+    freeaddrinfo(ai);
+    struct timeval tv = { .tv_sec = NTP_WAIT_SECS, .tv_usec = 0 };
+    setsockopt(s, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+
+    int rc = -1;
+    for (int i = 0; i < NTP_TRIES && rc != 0; i++) {
+        uint8_t q[48], r[64];
+        memset(q, 0, sizeof(q));
+        q[0] = 0x23;            /* no warning, version 4, client */
+        /* The server sends the transmit timestamp back. It need not be our
+         * time, as we keep that ourselves, so it can prove the reply is new. */
+        int fd = open("/dev/urandom", O_RDONLY);
+        if (fd < 0 || read(fd, q + 40, 8) != 8) {
+            uint32_t v = (uint32_t)(clock_now() * 1000.0);
+            memcpy(q + 40, &v, sizeof(v));
+        }
+        if (fd >= 0) close(fd);
+
+        double t1 = clock_now();
+        if (send(s, q, sizeof(q), MSG_NOSIGNAL) != (ssize_t)sizeof(q)) continue;
+        double end = t1 + NTP_WAIT_SECS;
+        while (clock_now() < end && clock_now() >= t1) {
+            ssize_t n = recv(s, r, sizeof(r), 0);
+            if (n < 0 && errno == EINTR) continue;
+            if (n < 0) break;
+            double t4 = clock_now();
+            if (n < 48 || memcmp(r + 24, q + 40, 8) != 0) continue;
+            if ((r[0] & 0x07) != 4 || (r[0] >> 6) == 3) continue;  /* not a server, not in sync */
+            if (r[1] == 0 || r[1] > 15) continue;                  /* stratum: refused or no clock */
+            if (be32(r + 40) == 0) continue;
+            *offset = ((ntp_time(r + 32) - t1) + (ntp_time(r + 40) - t4)) / 2.0;
+            rc = 0;
+            break;
+        }
+    }
+    close(s);
+    return rc;
+}
+
+/* Directly and not with hwclock -w: A child process that ends in system()
+ * sends its SIGCHLD to another thread, and that can break off a socket call. */
+static void rtc_write(void)
+{
+    int fd = open(RTC_PATH, O_RDONLY);
+    if (fd < 0) return;
+    time_t now = time(NULL);
+    struct tm tm;
+    gmtime_r(&now, &tm);
+    struct rtc_time rt;
+    memset(&rt, 0, sizeof(rt));
+    rt.tm_sec = tm.tm_sec;
+    rt.tm_min = tm.tm_min;
+    rt.tm_hour = tm.tm_hour;
+    rt.tm_mday = tm.tm_mday;
+    rt.tm_mon = tm.tm_mon;
+    rt.tm_year = tm.tm_year;
+    if (ioctl(fd, RTC_SET_TIME, &rt) != 0)
+        fprintf(stderr, "[time] could not write %s: %s\n", RTC_PATH, strerror(errno));
+    close(fd);
+}
+
+static int g_ntp_answers = 1;   /* so that the first failure is logged */
+
+/* Asks the server and corrects the clock. Returns 0 if it answered. */
+static int clock_correct(const char *configured)
+{
+    char server[128];
+    snprintf(server, sizeof(server), "%s", configured);
+    double offset = 0;
+    if (ntp_query(server, &offset) != 0) {
+        if (g_ntp_answers)
+            fprintf(stderr, "[time] no answer from %s, keeping current clock\n", configured);
+        g_ntp_answers = 0;
+        return -1;
+    }
+    g_ntp_answers = 1;
+    if (offset >= NTP_STEP_SECS || offset <= -NTP_STEP_SECS) {
+        double t = clock_now() + offset;
+        struct timeval tv;
+        tv.tv_sec = (time_t)t;
+        tv.tv_usec = (suseconds_t)((t - (double)tv.tv_sec) * 1e6);
+        if (settimeofday(&tv, NULL) != 0) {
+            fprintf(stderr, "[time] could not set the clock: %s\n", strerror(errno));
+            return 0;
+        }
+        fprintf(stderr, "[time] clock set from %s, it was off by %.1f s\n", configured, offset);
+    } else {
+        struct timeval d;
+        d.tv_sec = (time_t)offset;
+        d.tv_usec = (suseconds_t)((offset - (double)d.tv_sec) * 1e6);
+        if (adjtime(&d, NULL) != 0)
+            fprintf(stderr, "[time] adjtime: %s\n", strerror(errno));
+    }
+    rtc_write();
+    return 0;
 }
 
