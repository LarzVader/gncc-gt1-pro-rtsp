+/* How long a stop may take before we give up on the SDK and restart the
+ * camera. Waiting on would leave it without a picture until someone pulls
+ * the plug, as the watchdog thread goes on feeding. */
+#define CAP_STOP_TIMEOUT_S  60
+
+static void capture_stop_locked(void)
 {
     if (!g_cap_super_started) return;
     cap_run = 0;
+    for (int i = 0; i < CAP_STOP_TIMEOUT_S * 10 && !g_cap_super_done; i++)
+        usleep(100 * 1000);
+    if (!g_cap_super_done) {
+        /* Stop feeding first: whatever hangs next, the watchdog resets the
+         * board. reboot() switches it off before shutting down, so that is
+         * only for a camera without one. */
+        wdt_quit = 1;
+        fprintf(stderr, "[cap] shutdown still hangs after %d s, restarting the camera\n",
+                CAP_STOP_TIMEOUT_S);
+        sync();
+        sleep(20);
+        reboot(RB_AUTOBOOT);
+        for (;;) sleep(60);
+    }
     pthread_join(g_cap_super_tid, NULL);
     g_cap_super_started = 0;
 }
 
+void capture_stop(void)
+{
+    pthread_mutex_lock(&g_cap_ctl);
+    capture_stop_locked();
+    pthread_mutex_unlock(&g_cap_ctl);
+}
