+/* A restart reads the settings only after its stop, so one that has not got
+ * there yet covers every change saved so far. Returns 0 if there is one, and
+ * then the caller needs none of its own. */
+static pthread_mutex_t g_restart_mtx = PTHREAD_MUTEX_INITIALIZER;
+static int             g_restart_pending = 0;
+
+int capture_restart_request(void)
+{
+    pthread_mutex_lock(&g_restart_mtx);
+    int first = !g_restart_pending;
+    g_restart_pending = 1;
+    pthread_mutex_unlock(&g_restart_mtx);
+    return first;
+}
+
+/* Stop and start as one step: the main loop must not see the capture stopped
+ * in between, or it would start a second one. The settings are read here, as
+ * of two quick changes the second one may get here first. */
+int capture_restart(void)
+{
+    struct capture_cfg cfg;
+    pthread_mutex_lock(&g_cap_ctl);
+    capture_stop_locked();
+    pthread_mutex_lock(&g_restart_mtx);
+    g_restart_pending = 0;
+    pthread_mutex_unlock(&g_restart_mtx);
+    capture_cfg_get(&cfg);
+    int rc = capture_start_locked(&cfg);
+    pthread_mutex_unlock(&g_cap_ctl);
+    return rc;
+}
