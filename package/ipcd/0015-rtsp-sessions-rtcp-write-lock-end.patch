+/* A thread stuck in a send can sleep through a whole capture restart,
+ * until the next start has cleared g_shutdown. The counter still tells. */
+static int client_stopping(const struct client_ctx *c)
+{
+    return g_shutdown || c->shutdowns != g_shutdown_count;
+}
+
+/* How long a client may take no data at all before we give up on it. A
+ * Wi-Fi outage of some 12 seconds still recovers with this. */
+#define SEND_STALL_SECS 20
+
+/* Sends all of it or fails, so that neither a signal nor a full buffer
+ * tears a frame. Each send waits for SO_SNDTIMEO, one second: Whoever holds
+ * write_mtx must see a capture restart, because serve_client may be waiting
+ * for the lock, and it is the one to end the connection. */
+static int send_all(struct client_ctx *c, const void *buf, size_t len)
+{
+    const char *p = buf;
+    int stalled = 0;
+    while (len > 0) {
+        ssize_t n = send(c->conn_fd, p, len, MSG_NOSIGNAL);
+        if (n >= 0) {
+            p += n;
+            len -= (size_t)n;
+            stalled = 0;
+        } else if (errno == EINTR) {
+            continue;
+        } else if ((errno != EAGAIN && errno != EWOULDBLOCK) ||
+                   ++stalled >= SEND_STALL_SECS) {
+            return -1;
+        }
+        if (len > 0 && client_stopping(c)) return -1;
+    }
+    return 0;
+}
